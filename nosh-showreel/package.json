{
  "name": "nosh-showreel",
  "version": "1.0.0",
  "private": true,
  "description": "60-second motion graphics showreel for Nosh AI Automation (noshaiautomation.com), built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "audio": "python3 audio/generate_soundtrack.py",
    "audio:vertical": "node scripts/export-cues.mjs src/vertical/cues.ts audio/vertical-cues.json && python3 audio/generate_vertical_soundtrack.py",
    "still": "remotion still NoshShowreel",
    "render": "remotion render NoshShowreel out/nosh-ai-automation-showreel.mp4",
    "render:vertical": "remotion render NoshVideoEditingVertical out/nosh-video-editing-vertical.mp4"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "lucide-react": "1.48.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
